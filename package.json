{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cf:dev": "npx @cloudflare/next-on-pages",
    "cf:preview": "npx @cloudflare/next-on-pages && npx wrangler pages dev .vercel/output/static",
    "cf:deploy": "npx @cloudflare/next-on-pages && npx wrangler pages deploy .vercel/output/static",
    "cf:init": "npx wrangler d1 create eruem",
    "cf:migrate:local": "npx wrangler d1 execute eruem --local --file=d1/schema.sql",
    "cf:migrate:remote": "npx wrangler d1 execute eruem --remote --file=d1/schema.sql"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.0",
    "@cloudflare/workerd-windows-64": "^1.20260728.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.1",
    "class-variance-authority": "^0.7.1",
    "iron-session": "^8.0.4",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250728.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "wrangler": "^3.100.0"
  }
}
